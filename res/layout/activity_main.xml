<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="52dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_title"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/header_sub"
                android:textColor="#DCE7FF"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="-34dp"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_status_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#444B57"/>

            <Button
                android:id="@+id/btnEnable"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary"
                android:text="@string/btn_enable"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnChoose"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_choose"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_settings_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_theme"
                android:textColor="#5A6373"
                android:textSize="14sp"/>

            <RadioGroup
                android:id="@+id/rgTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/theme_auto"
                    android:textSize="15sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/theme_light"
                    android:textSize="15sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/theme_dark"
                    android:textSize="15sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbAmoled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/theme_amoled"
                    android:textSize="15sp"
                    android:textColor="@color/text_main"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_accent"
                android:textColor="#5A6373"
                android:textSize="14sp"/>

            <RadioGroup
                android:id="@+id/rgAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbAccBlue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_blue"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbAccTeal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_teal"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbAccPurple"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_purple"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbAccAmber"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_amber"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbAccRed"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/acc_red"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_height"
                android:textColor="#5A6373"
                android:textSize="14sp"/>

            <RadioGroup
                android:id="@+id/rgHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbHSmall"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/h_small"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbHMedium"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/h_medium"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>

                <RadioButton
                    android:id="@+id/rbHLarge"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/h_large"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"/>
            </RadioGroup>

            <Switch
                android:id="@+id/swNumRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="6dp"
                android:text="@string/sw_numrow"
                android:textSize="15sp"
                android:textColor="@color/text_main"/>

            <Switch
                android:id="@+id/swAutoCap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/sw_autocap"
                android:textSize="15sp"
                android:textColor="@color/text_main"/>

            <Switch
                android:id="@+id/swDoubleSpace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/sw_double_space"
                android:textSize="15sp"
                android:textColor="@color/text_main"/>

            <Switch
                android:id="@+id/swSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="6dp"
                android:text="@string/sw_sound"
                android:textSize="15sp"
                android:textColor="@color/text_main"/>

            <Switch
                android:id="@+id/swHaptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/sw_haptic"
                android:textSize="15sp"
                android:textColor="@color/text_main"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_note"
                android:textColor="#8A93A3"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_try_title"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minLines="3"
                android:gravity="top"
                android:hint="@string/try_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:background="@drawable/btn_secondary"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="14dp"
            android:text="@string/footer_tips"
            android:textColor="#8A93A3"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
